# Optional but recommended: raises GitHub rate limit to 5000/h and enables the full-year contribution graph (GraphQL)
GITHUB_TOKEN=
# Optional: makes DevBot + Profile Coach use Claude instead of the built-in rule engine
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Cache freshness in minutes
CACHE_TTL_MINUTES=60
DEFAULT_USERNAME=torvalds
DB_PATH=portfolio_cache.db
